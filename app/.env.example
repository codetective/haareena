# Copy to .env.local and fill in. Without a key, players paste their address instead.
VITE_POLLAR_PUBLISHABLE_KEY=pub_testnet_...
# Optional. Defaults to ws://<page host>:8787 on HTTP and wss://<page host>:8787 on HTTPS.
# HTTPS deployments need a TLS-terminated WebSocket endpoint.
# VITE_WS_URL=ws://localhost:8787
